# Production: deploy behind an HTTPS reverse proxy; never expose Node directly.
NODE_ENV=production
# REQUIRED: a random 32-byte key encoded as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_ENCRYPTION_KEY=
# Server-only host; restricted to Roblox to prevent credential exfiltration.
ROBLOX_API_BASE=https://apis.roblox.com
